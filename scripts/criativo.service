[Unit]
Description=Criativo AI Studio Online Daemon (15 Agentes + WhatsApp + Remotion)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=criativo
Group=criativo
WorkingDirectory=/opt/criativo-ai-studio-online
EnvironmentFile=-/etc/criativo/criativo.env
ExecStart=/usr/bin/node /opt/criativo-ai-studio-online/apps/daemon/dist/server/daemon-server.js
Restart=always
RestartSec=5
RuntimeDirectory=criativo
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/criativo /opt/criativo-ai-studio-online /run/criativo

[Install]
WantedBy=multi-user.target
