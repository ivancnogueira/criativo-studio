{
  "name": "criativo-studio-online",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma autônoma multi-agente para produção de criativos, carrosséis, stories e vídeos cinematográficos Remotion via Web, WhatsApp e Telegram.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/i18n packages/whatsapp apps/daemon",
    "build:all": "npm run build && npm run build:web",
    "typecheck": "tsc -b packages/contracts packages/i18n packages/whatsapp apps/daemon",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:migrations": "node scripts/check-frozen-migrations.mjs",
    "check:ratchets": "node scripts/check-quality-ratchets.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "start": "npm run start:daemon",
    "instalar": "node scripts/configurar-local.mjs",
    "configurar": "node scripts/configurar-local.mjs",
    "instalar-skills": "node scripts/instalar-skills.mjs",
    "desinstalar-skills": "node scripts/instalar-skills.mjs --remover",
    "instalar-upgrade": "node scripts/instalar-upgrade.mjs",
    "atualizar": "node scripts/atualizar.mjs",
    "validar:integracoes": "node scripts/validar-integracoes.mjs",
    "diagnosticar": "node scripts/diagnosticar.mjs",
    "start:daemon": "npm run start --workspace=apps/daemon",
    "test:daemon": "npm run test --workspace=apps/daemon",
    "test:e2e": "node --test testes/e2e/*.test.mjs",
    "prepare:desktop-bundle": "node apps/desktop/scripts/prepare-bundle.mjs",
    "build:web": "npm run build --workspace=apps/web",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "dist:desktop:win": "node ./node_modules/electron-builder/cli.js --project apps/desktop --config electron-builder.yml --win nsis --x64",
    "dist:desktop:linux": "node ./node_modules/electron-builder/cli.js --project apps/desktop --config electron-builder.yml --linux tar.gz --x64",
    "dist:desktop:mac": "node ./node_modules/electron-builder/cli.js --project apps/desktop --config electron-builder.yml --mac dmg zip"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "app-builder-bin": "^5.0.0-alpha.13",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "app-builder-bin@5.0.0-alpha.13": true,
    "app-builder-bin@5.0.0-alpha.10": true
  }
}
