# Configuração Local do Criativo AI Studio Online
# Preencha apenas na sua máquina local. Nunca envie este arquivo para o Git.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Chave mestra para cifrar o Cofre AES-256-GCM no SQLite (gerada automaticamente por npm run configurar)
CRIATIVO_VAULT_KEY=

# Credenciais opcionais (também podem ser salvas cifradas pela UI em Conexões -> Cofre / Apps)
# META_ACCESS_TOKEN=
# META_IG_USER_ID=
# META_API_VERSION=v21.0
